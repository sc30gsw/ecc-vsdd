{
  "description": "Enforce pinned agent model/effort, reject subagent model overrides, and keep Fable in the control plane",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/vsdd-model-guard.py",
              "--user-prompt-submit"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/vsdd-model-guard.py",
              "--session-start"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/vsdd-model-guard.py"
            ]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "ecc-vsdd:vsdd-pr-worker",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/vsdd-model-guard.py",
              "--subagent-start"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/vsdd-model-guard.py",
              "--session-end"
            ]
          }
        ]
      }
    ]
  }
}
